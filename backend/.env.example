# Copy to .env and fill in real values:
#   cp .env.example .env

# Server (Hostinger sets PORT automatically; local default is 5000)
PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aguadoc

# Optional fallbacks — prefer configuring these in Admin → Settings
# Xendit Dashboard → Settings → API Keys (use Test mode secret key)
XENDIT_SECRET_KEY=xnd_development_your_secret_key_here

# Xendit Dashboard → Settings → Webhooks → Verification token
XENDIT_WEBHOOK_TOKEN=your_webhook_verification_token_here

# Your ngrok HTTPS URL for this backend (run: ngrok http 5000, then node update-ngrok-url.js)
BACKEND_PUBLIC_URL=https://xxxx.ngrok-free.dev

# Semaphore SMS (https://semaphore.co) — optional .env fallback
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=

# Geoapify (MapLibre maps + routing + geocoding) — optional .env fallback
# https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Customer-facing frontend (production site URL). After GCash, /return redirects here.
# Also configurable in Admin → Settings → Frontend URL.
FRONTEND_URL=http://localhost:5173
